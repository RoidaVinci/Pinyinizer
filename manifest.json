{
  "manifest_version": 3,
  "name": "Translate and Pinyin toolbox",
  "version": "0.2.0",
  "description": "Multi-use toolbox for language translation, pinyin/pinyin+english annotation in Chinese websites. Useful to both translate websites for common use and learn Chinese.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/**", "src/common/**"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/ui/popup/index.html",
    "default_title": "Clean Translate"
  },
  "options_page": "src/ui/options/index.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "default_locale": "en"
}
